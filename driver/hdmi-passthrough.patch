 			break;
 
@@ -2960,6 +3011,41 @@ static OSStatus	BlackHole_SetDevicePropertyData(AudioServerPlugInDriverRef inDri
 	//	property in the BlackHole_GetDevicePropertyData() method.
 	switch(inAddress->mSelector)
 	{
+		case MATB_DOLBY_FORMATS_SELECTOR:
+		{
+			FailWithAction(inObjectID != kObjectID_Device, theAnswer = kAudioHardwareUnknownPropertyError, Done, "BlackHole_SetDevicePropertyData: no Dolby formats on this device");
+			FailWithAction(inDataSize != sizeof(CFPropertyListRef), theAnswer = kAudioHardwareBadPropertySizeError, Done, "BlackHole_SetDevicePropertyData: wrong size for the Dolby formats");
+			CFPropertyListRef theList = *((const CFPropertyListRef*)inData);
+			FailWithAction(theList == NULL || CFGetTypeID(theList) != CFDataGetTypeID(), theAnswer = kAudioHardwareIllegalOperationError, Done, "BlackHole_SetDevicePropertyData: the Dolby formats must be a CFData");
+			CFIndex theLength = CFDataGetLength((CFDataRef)theList);
+			FailWithAction(theLength % sizeof(AudioStreamRangedDescription) != 0, theAnswer = kAudioHardwareBadPropertySizeError, Done, "BlackHole_SetDevicePropertyData: the Dolby formats are not AudioStreamRangedDescriptions");
+			const AudioStreamRangedDescription* theNew = (const AudioStreamRangedDescription*)CFDataGetBytePtr((CFDataRef)theList);
+			AudioStreamRangedDescription theKept[kMATB_MaxDolbyFormats];
+			UInt32 theCount = 0;
+			for (CFIndex i = 0; i < theLength / (CFIndex)sizeof(AudioStreamRangedDescription) && theCount < kMATB_MaxDolbyFormats; i++)
+			{
+				// Encoded formats only: what this device mixes and plays stays its own float LPCM.
+				if (theNew[i].mFormat.mFormatID != kAudioFormatLinearPCM && theNew[i].mFormat.mFormatID != 0) { theKept[theCount++] = theNew[i]; }
+			}
+			pthread_mutex_lock(&gPlugIn_StateMutex);
+			Boolean theChanged = theCount != gMATB_DolbyFormatCount || memcmp(theKept, gMATB_DolbyFormats, theCount * sizeof(AudioStreamRangedDescription)) != 0;
+			memcpy(gMATB_DolbyFormats, theKept, theCount * sizeof(AudioStreamRangedDescription));
+			gMATB_DolbyFormatCount = theCount;
+			pthread_mutex_unlock(&gPlugIn_StateMutex);
+			if (theChanged)
+			{
+				*outNumberPropertiesChanged = 1;
+				outChangedAddresses[0].mSelector = MATB_DOLBY_FORMATS_SELECTOR;
+				outChangedAddresses[0].mScope = kAudioObjectPropertyScopeGlobal;
+				outChangedAddresses[0].mElement = kAudioObjectPropertyElementMain;
+				// The HAL caches a stream's format list and only re-reads it in a configuration change (a no-op
+				// action in BlackHole_PerformDeviceConfigurationChange; IO pauses briefly, and only when the TV's
+				// formats actually change).
+				dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{ gPlugIn_Host->RequestDeviceConfigurationChange(gPlugIn_Host, kObjectID_Device, kMATB_ChangeAction_DolbyFormats, NULL); });
+			}
+			break;
+		}
+
 		case kAudioDevicePropertyNominalSampleRate:
 			//	Changing the sample rate needs to be handled via the
 			//	RequestConfigChange/PerformConfigChange machinery.
@@ -3144,6 +3230,12 @@ static OSStatus	BlackHole_GetStreamPropertyDataSize(AudioServerPlugInDriverRef i
 		case kAudioStreamPropertyAvailableVirtualFormats:
