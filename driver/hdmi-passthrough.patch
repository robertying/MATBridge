 static matb_shm_header*             gShm = NULL;
 
+// MATBridge: Apple Music only passes Dolby Atmos (and AC-3/E-AC-3) through as a bitstream when the default output
+// device is an HDMI device that lists the encoded formats. The default output is this device, so it reports HDMI
+// transport and lists exactly the encoded formats the TV offers right now. The MATBridge app copies them from the TV
+// into the custom property MATB_DOLBY_FORMATS_SELECTOR (a CFData of AudioStreamRangedDescription); with no TV, or a
+// TV without Dolby formats, the list is empty and Music decodes as usual. The formats are only listed: setting one
+// is refused, so this device never carries a bitstream (Music sends it to the TV itself).
+#define                             kMATB_MaxDolbyFormats               32
+static AudioStreamRangedDescription gMATB_DolbyFormats[kMATB_MaxDolbyFormats];
+static UInt32                       gMATB_DolbyFormatCount              = 0;
+#define                             kMATB_ChangeAction_DolbyFormats     100  // see BlackHole_SetDevicePropertyData
+
 static void MATB_ShmMapIfNeeded(void)
 {
     if (gShm != NULL) { return; }
@@ -2043,7 +2054,7 @@ static OSStatus	BlackHole_GetBoxPropertyData(AudioServerPlugInDriverRef inDriver
 			//	any 32 bit integer, but common values for this property are defined in
 			//	<CoreAudio/AudioHardwareBase.h>
 			FailWithAction(inDataSize < sizeof(UInt32), theAnswer = kAudioHardwareBadPropertySizeError, Done, "BlackHole_GetBoxPropertyData: not enough space for the return value of kAudioDevicePropertyTransportType for the box");
-			*((UInt32*)outData) = kAudioDeviceTransportTypeVirtual;
