+
 		case kAudioObjectPropertyBaseClass:
 			*outDataSize = sizeof(AudioClassID);
 			break;
@@ -2511,6 +2545,23 @@ static OSStatus	BlackHole_GetDevicePropertyData(AudioServerPlugInDriverRef inDri
 	//	it is necessary to lock the state mutex.
 	switch(inAddress->mSelector)
 	{
+		case kAudioObjectPropertyCustomPropertyInfoList:
+			if (inObjectID != kObjectID_Device || inDataSize < sizeof(AudioServerPlugInCustomPropertyInfo)) { *outDataSize = 0; break; }
+			((AudioServerPlugInCustomPropertyInfo*)outData)->mSelector = MATB_DOLBY_FORMATS_SELECTOR;
+			((AudioServerPlugInCustomPropertyInfo*)outData)->mPropertyDataType = kAudioServerPlugInCustomPropertyDataTypeCFPropertyList;
+			((AudioServerPlugInCustomPropertyInfo*)outData)->mQualifierDataType = kAudioServerPlugInCustomPropertyDataTypeNone;
+			*outDataSize = sizeof(AudioServerPlugInCustomPropertyInfo);
+			break;
+
+		case MATB_DOLBY_FORMATS_SELECTOR:
+			FailWithAction(inObjectID != kObjectID_Device, theAnswer = kAudioHardwareUnknownPropertyError, Done, "BlackHole_GetDevicePropertyData: no Dolby formats on this device");
+			FailWithAction(inDataSize < sizeof(CFPropertyListRef), theAnswer = kAudioHardwareBadPropertySizeError, Done, "BlackHole_GetDevicePropertyData: not enough space for the Dolby formats");
