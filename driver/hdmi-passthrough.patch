 	switch(inAddress->mSelector)
 	{
+		case kAudioObjectPropertyCustomPropertyInfoList:
+			*outDataSize = inObjectID == kObjectID_Device ? sizeof(AudioServerPlugInCustomPropertyInfo) : 0;
+			break;
+
+		case MATB_DOLBY_FORMATS_SELECTOR:
+			FailWithAction(inObjectID != kObjectID_Device, theAnswer = kAudioHardwareUnknownPropertyError, Done, "BlackHole_GetDevicePropertyDataSize: no Dolby formats on this device");
+			*outDataSize = sizeof(CFPropertyListRef);
